{
  "$meta": {
    "name": "lastfomo tokens",
    "system": "Illuminated Protocol v1.0 (Figma), as shipped on the landing page",
    "source": "Single source of truth. tools/build.mjs generates site/tokens.css from this file; never edit the CSS by hand.",
    "figma": {
      "brandbook": "https://www.figma.com/design/rgztGHmGiCjoPUCDxdq0Pz",
      "marks": { "horse": "9:4 (Logo/Mark 9:3)", "wordmark": "9:5", "lockup": "9:7 horizontal, 9:12 stacked" }
    }
  },
  "color": {
    "void": "#080808",
    "ink": "#111111",
    "graphite": "#1c1c1c",
    "iron": "#2a2a2a",
    "ash": "#8c8c8c",
    "paper": "#ffffff",
    "mist": "#f4f4f4",
    "sealed": "#9a9a9a",
    "machina": "#d4f70d",
    "hortus": "#46ed08",
    "arca": "#ff0a96",
    "scrim": "rgba(8,8,8,.78)",
    "scrim-strong": "rgba(8,8,8,.94)",
    "paper-line": "rgba(255,255,255,.3)"
  },
  "theme": {
    "$note": "Light (Mist) values sit on bare :root; dark (Night) values follow prefers-color-scheme and data-theme. Plates and video windows stay dark in both themes because they are images.",
    "light": {
      "bg": "#f4f4f4",
      "bg2": "#e9e9e9",
      "fg": "#111111",
      "fg2": "#555555",
      "line": "rgba(17,17,17,.16)",
      "line2": "rgba(17,17,17,.08)",
      "glass": "rgba(244,244,244,.8)",
      "plate": "#080808",
      "machina-t": "#4f5c00",
      "hortus-t": "#1c6a00",
      "arca-t": "#b3006a",
      "error": "#b3261e"
    },
    "dark": {
      "bg": "#111111",
      "bg2": "#1c1c1c",
      "fg": "#ffffff",
      "fg2": "#8c8c8c",
      "line": "rgba(255,255,255,.16)",
      "line2": "rgba(255,255,255,.08)",
      "glass": "rgba(17,17,17,.74)",
      "plate": "#080808",
      "machina-t": "#d4f70d",
      "hortus-t": "#46ed08",
      "arca-t": "#ff4fae",
      "error": "#ff8a80"
    }
  },
  "wing": {
    "$note": "Wing modes. One wing colour per composition; the trio appears together only at house level, ordered hortus, machina, arca.",
    "house":   { "code": "LF",  "name": "lastfomo", "line": "What grows. What thinks. What lasts.", "field": "Research house" },
    "hortus":  { "code": "HRT", "name": "hortus",   "line": "What grows.",  "field": "Nature research",     "signal": "#46ed08" },
    "machina": { "code": "MCH", "name": "machina",  "line": "What thinks.", "field": "Autonomous AI",       "signal": "#d4f70d" },
    "arca":    { "code": "ARC", "name": "arca",     "line": "What lasts.",  "field": "Art & collections",   "signal": "#ff0a96" },
    "wing04":  { "code": "04",  "name": "Wing 04",  "line": "In the works.", "field": "Sealed",             "signal": "#9a9a9a" }
  },
  "type": {
    "display": { "family": "\"Jacquard 24\",\"Geist Mono\",ui-monospace,monospace", "weight": 400, "use": "brand names only: lastfomo, machina, hortus, arca" },
    "sans":    { "family": "\"Geist\",ui-sans-serif,system-ui,-apple-system,\"Segoe UI\",Helvetica,Arial,sans-serif", "weights": [300, 400], "use": "Light for headlines and big numbers, Regular for body" },
    "mono":    { "family": "\"Geist Mono\",ui-monospace,SFMono-Regular,Menlo,Consolas,monospace", "weight": 500, "use": "labels, codes, specs, buttons; uppercase, tracked .1em to .14em" },
    "googleFonts": "https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500&family=Geist+Mono:wght@400;500&family=Jacquard+24&display=swap"
  },
  "motion": {
    "snap": "120ms",
    "glide": "320ms",
    "drift": "960ms",
    "ease": "cubic-bezier(.2,0,0,1)",
    "exit": "cubic-bezier(.4,0,1,1)"
  },
  "layout": {
    "m": "clamp(20px,5vw,96px)",
    "gl": "max(var(--m),env(safe-area-inset-left,0px))",
    "gr": "max(var(--m),env(safe-area-inset-right,0px))",
    "bar": "64px",
    "max": "1320px"
  }
}
